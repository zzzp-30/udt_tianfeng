   "source": [
    "def split_volume(max_volume: int, total_volume: int) -> list[int]:\n",
    "    \"\"\"自动拆单\"\"\"\n",
    "    return (\n",
    "        [max_volume]\n",
    "        * (total_volume // max_volume)\n",
    "        + ([_v] if (_v := total_volume % max_volume) else [])\n",
    "    )"
   ]
  },
